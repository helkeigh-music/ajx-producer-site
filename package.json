{
  "name": "ajx-producer-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:vite": "vite",
    "dev:vercel": "npx vercel dev",
    "build": "next build && node scripts/verify-url-parity.mjs",
    "build:vite": "tsc -p tsconfig.vite.json --noEmit && vite build && node scripts/sitemap.mjs && node scripts/injectStaticHtmlMeta.mjs && node scripts/injectAnalytics.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:urls": "node scripts/verify-url-parity.mjs",
    "sitemap": "node scripts/sitemap.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^0.27.0",
    "next": "^15.5.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
